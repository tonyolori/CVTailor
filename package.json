{
  "name": "jobtailor",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "test:rls": "npm run test:rls -w @jobtailor/worker",
    "seed:personas": "npm run seed:personas -w @jobtailor/worker --",
    "seed:tony": "npm run seed:tony -w @jobtailor/worker --",
    "seed:companies": "npm run seed:companies -w @jobtailor/worker --",
    "claude:login": "npm run claude:login -w @jobtailor/llm",
    "llm:check": "npm run llm:check -w @jobtailor/worker",
    "eval:enrich": "npm run eval:enrich -w @jobtailor/worker --",
    "worker": "npm run start -w @jobtailor/worker --",
    "web": "npm run dev -w @jobtailor/web",
    "test:integration": "npm run test:integration -w @jobtailor/worker"
  },
  "devDependencies": {
    "supabase": "^3.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "supabase": true
  }
}
