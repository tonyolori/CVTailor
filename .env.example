# Copy to .env. Only this file is committed.

# --- Worker (your PC or a VPS). Never expose the service role key to the browser. ---
# Local values come from `npx supabase status`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# Only used by the RLS tests, to act as a normal signed-in user.
SUPABASE_ANON_KEY=

# --- AI provider ---
# claude-subscription: your own Claude login, no API key. For you and synthetic personas only.
# anthropic-api: API key, any invited user.
# fake: deterministic responses, no network.
LLM_PROVIDER=claude-subscription
# The JobTailor account allowed to use subscription mode. Also receives failed-run alerts.
OWNER_EMAIL=
# Leave empty in subscription mode: if set, it takes precedence over your login and bills the API.
ANTHROPIC_API_KEY=
# Small model for enrichment and scoring, stronger one for CVs and cover letters.
# claude-sonnet-5-5 is a cheaper option for LLM_MODEL_STRONG if quality holds up on your evals.
LLM_MODEL_SMALL=claude-haiku-5-5
LLM_MODEL_STRONG=claude-opus-5-5

# Hard stop for the whole service per UTC day, in USD. In subscription mode this applies
# to the SDK's cost estimate, which keeps a run from eating your plan's limits.
GLOBAL_DAILY_BUDGET_USD=5
# Default per-user daily budget, in USD
USER_DAILY_BUDGET_USD=0.50

# --- Pipeline ---
# Hour (UTC) after which a missing run triggers an alert to OWNER_EMAIL.
RUN_ALERT_HOUR_UTC=6
# false: every invited user gets full service (testing). true: free plan gets the weekly digest only.
BILLING_ENFORCED=false

# --- Email ---
# resend: real sending. file: writes HTML to .local/outbox for inspection.
EMAIL_PROVIDER=file
EMAIL_API_KEY=
EMAIL_FROM="JobTailor <hello@yourdomain.com>"
SITE_URL=http://127.0.0.1:3000

# --- Web app ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# --- Payments (later) ---
PAYSTACK_SECRET_KEY=
