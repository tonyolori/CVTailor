# Copy to .env. Only this file is committed.

# --- Worker (your PC or a VPS). Never expose the service role key to the browser. ---
# Local values come from `npx supabase status`. Its "Secret" key goes here. Server-only.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# The "Publishable" key. Only used by the RLS tests, to act as a normal signed-in user.
SUPABASE_ANON_KEY=

# --- AI provider. Set these on the web host too: it writes CVs and reads uploads as people ask. ---
# claude-subscription: your own Claude login, no API key. Worker only, for you and synthetic personas.
# anthropic-api: API key, any invited user.
# deepseek: API key, any invited user. Sends people's CV data to DeepSeek. See docs/SETUP.md first.
# fake: deterministic responses, no network.
LLM_PROVIDER=claude-subscription
# The CV Tailor account allowed to use subscription mode. Also receives failed-run alerts.
OWNER_EMAIL=
# Leave empty in subscription mode: if set, it takes precedence over your login and bills the API.
ANTHROPIC_API_KEY=
# Only read when LLM_PROVIDER=deepseek.
DEEPSEEK_API_KEY=
# Small: enrichment, scoring and title suggestions. Strong: CVs, cover letters and CV import.
# These must match the provider. For deepseek: deepseek-flash and deepseek-v4-pro.
LLM_MODEL_SMALL=claude-haiku-5-5
LLM_MODEL_STRONG=claude-sonnet-5-5

# Hard stop for the whole service per UTC day, in USD. The worker and the web host share it, so set
# the same values on both. In subscription mode it applies to the SDK's cost estimate.
GLOBAL_DAILY_BUDGET_USD=5
# Default per-user daily budget, in USD
USER_DAILY_BUDGET_USD=0.50
# A safeguard against abuse, on top of each person's allowance: CVs they can ask for per UTC day.
# Web host only.
CV_REQUESTS_PER_DAY=7

# --- Pipeline ---
# Most postings enriched per run. The rest wait for the next run. On a personal plan each call
# takes several seconds and shares your limits, so keep this modest there.
ENRICH_MAX_PER_RUN=100
# Hour (UTC) the daily run starts. A worker started later catches up on a missed day.
# On deepseek use 4: weekdays 01:00-04:00 and 06:00-10:00 UTC cost double.
RUN_START_HOUR_UTC=1
# Hour (UTC) after which a missing run triggers an alert to OWNER_EMAIL.
RUN_ALERT_HOUR_UTC=6
# false: every invited user gets unlimited CVs (testing). true: each CV uses up the person's allowance.
# Matches are free either way. Set the same value on the web host and the worker.
BILLING_ENFORCED=false
# Sources whose terms are unverified stay off unless listed here. See docs/SOURCES.md.
ENABLED_UNVERIFIED_SOURCES=

# --- Email ---
# resend: real sending. file: writes HTML to .local/outbox for inspection.
EMAIL_PROVIDER=file
EMAIL_API_KEY=
EMAIL_FROM="CV Tailor <hello@yourdomain.com>"
# Optional. Where replies go. When set, the welcome email asks people to reply with feedback.
EMAIL_REPLY_TO=
SITE_URL=http://127.0.0.1:3000

# --- Web app ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# The "Publishable" key again. Rebuild the web app after changing it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Protects /api/cron/run-check. Vercel Cron sends it automatically when set.
CRON_SECRET=

# --- Payments: Paystack. Web app only. ---
PAYSTACK_SECRET_KEY=
# Prices in naira. Leave one empty to hide that plan. The monthly price must match the plan in Paystack.
PRICE_MONTHLY_NAIRA=
PRICE_PASS_NAIRA=
PRICE_TOP_UP_NAIRA=
# CVs in a plan or 30-day pass, in a top-up, and given once to a new account. Web app only.
CVS_PER_PLAN=30
CVS_PER_TOP_UP=10
FREE_CVS=3
PAYSTACK_PLAN_CODE_MONTHLY=
