# Worker (runs on your PC / VPS). Never expose the service role key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Hard stop for the whole service per UTC day, in USD
GLOBAL_DAILY_BUDGET_USD=5
# Default per-user daily budget, in USD
USER_DAILY_BUDGET_USD=0.50

# Email (Resend or Brevo)
EMAIL_API_KEY=
EMAIL_FROM="JobTailor <hello@yourdomain.com>"

# Web app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Payments (later)
PAYSTACK_SECRET_KEY=
